generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  password  String    @map("password_hash") @db.VarChar(255)
  active    Boolean?  @default(true)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model encarte_estabelecimentos {
  encarte_id         String
  estabelecimento_id String
  encartes           encartes         @relation(fields: [encarte_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  estabelecimentos   estabelecimentos @relation(fields: [estabelecimento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([encarte_id, estabelecimento_id])
}

model encartes {
  id                       String                     @id @default(uuid())
  titulo                   String                     @db.VarChar(255)
  descricao                String?
  data_validade            DateTime?                  @db.Date
  imagem_capa_url          String?                    @db.VarChar(500)
  localidade_id            String?
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  encarte_estabelecimentos encarte_estabelecimentos[]
  localidades              localidades?               @relation(fields: [localidade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([localidade_id], map: "idx_encartes_localidade")
}

model especialidades {
  id                 String            @id @default(uuid())
  nome               String            @db.VarChar(255)
  estabelecimento_id String?
  estabelecimentos   estabelecimentos? @relation(fields: [estabelecimento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model estabelecimentos {
  id                       String                     @id @default(uuid())
  nome                     String                     @db.VarChar(255)
  descricao                String?
  logo_url                 String?                    @db.VarChar(500)
  endereco                 String?                    @db.VarChar(500)
  telefone                 String?                    @db.VarChar(50)
  whatsapp                 String?                    @db.VarChar(50)
  avaliacao_media          Decimal?                   @default(0.00) @db.Decimal(3, 2)
  total_avaliacoes         Int?                       @default(0)
  localidade_id            String?
  segmento_id              String?
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                  @default(now()) @db.Timestamp(6)
  encarte_estabelecimentos encarte_estabelecimentos[]
  especialidades           especialidades[]
  localidades              localidades?               @relation(fields: [localidade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  segmentos                segmentos?                 @relation(fields: [segmento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  redes_sociais            redes_sociais[]

  @@index([localidade_id], map: "idx_estabelecimentos_localidade")
  @@index([segmento_id], map: "idx_estabelecimentos_segmento")
}

model localidades {
  id               String             @id @default(uuid())
  nome             String             @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  encartes         encartes[]
  estabelecimentos estabelecimentos[]
}

model redes_sociais {
  id                 String            @id @default(uuid())
  plataforma         String            @db.VarChar(50)
  url                String            @db.VarChar(500)
  estabelecimento_id String?
  estabelecimentos   estabelecimentos? @relation(fields: [estabelecimento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model schema_migrations {
  version BigInt  @id
  dirty   Boolean
}

model segmentos {
  id               String             @id @default(uuid())
  nome             String             @db.VarChar(255)
  icone_url        String?            @db.VarChar(500)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  estabelecimentos estabelecimentos[]
}
