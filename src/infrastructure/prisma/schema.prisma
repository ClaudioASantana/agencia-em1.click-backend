generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                @id @default(autoincrement()) @map("Id")
  email              String             @unique @map("Email")
  password           String             @map("Senha")
  name               String?            @map("Nome")
  role               String             @default("STORE_OWNER")
  active             Boolean            @default(true) @map("Ativo")
  emailVerified      Boolean            @default(false)
  verificationToken  String?
  createdAt          DateTime           @default(now()) @map("DataCadastro")
  updatedAt          DateTime           @updatedAt @map("DataAtualizacao")
  resetToken         String?
  resetTokenExpires  DateTime?
  notificationOptOut Boolean            @default(false)
  follows            Follow[]
  establishments     Establishment[]    @relation("EstablishmentToUser")
  subscription       Subscription?
  sweepstakeTickets  SweepstakeTicket[]
  loyaltyPoints      LoyaltyPoint[]

  @@map("Cliente")
}

model Plan {
  id                Int            @id @default(autoincrement())
  name              String         @unique
  description       String?
  price             Float          @default(0)
  trialDays         Int            @default(0)
  active            Boolean        @default(true)
  maxPublications   Int            @default(1)
  maxOffersPerPub   Int            @default(5)
  maxEstablishments Int            @default(1)
  allowsHighlight   Boolean        @default(false)
  allowsAnalytics   Boolean        @default(false)
  createdAt         DateTime       @default(now())
  subscriptions     Subscription[]

  @@map("Plano")
}

model Subscription {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  planId    Int
  status    String    @default("ACTIVE")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@map("Assinatura")
}

model Location {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  slug           String?         @unique
  description    String?
  title          String?
  population     String?
  area           String?
  founded        String?
  state          String?
  city           String?
  image          String?
  stats          Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  establishments Establishment[]
  qrImpulses     QrImpulse[]
  qrTemplates    QrTemplate[]
  encartes       Encarte[]

  @@index([city])
  @@index([state])
  @@map("Localidade")
}

model Segment {
  id             Int             @id @default(autoincrement()) @map("Id")
  name           String          @unique @map("DescricaoSegmento")
  slug           String?         @unique
  createdAt      DateTime        @default(now()) @map("DataCadastro")
  updatedAt      DateTime        @updatedAt @map("DataAtualizacao")
  establishments Establishment[]
  qrSlots        QrSlot[]

  @@map("Segmento")
}

model Establishment {
  id                 Int              @id @default(autoincrement()) @map("Id")
  slug               String           @unique
  name               String           @map("NomeLoja")
  description        String?          @map("Descricao")
  image              String?          @map("ImagemCapa")
  logo               String?          @map("ImagemLogo")
  rating             Float?           @default(0)
  phone              String?          @map("Telefone")
  whatsapp           String?          @map("WhatsApp")
  address            String?          @map("Logradouro")
  hours              String?
  specialties        String?
  instagram          String?
  facebook           String?
  website            String?
  latitude           Float?
  longitude          Float?
  locationId         Int
  segmentId          Int
  showPrice          Boolean          @default(false)
  isAgency           Boolean          @default(false)
  estandeSustentavel Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("DataCadastro")
  updatedAt          DateTime         @updatedAt @map("DataAtualizacao")
  location           Location         @relation(fields: [locationId], references: [id])
  segment            Segment          @relation(fields: [segmentId], references: [id])
  follows            Follow[]
  offers             Offer[]
  publications       Publication[]
  users              User[]           @relation("EstablishmentToUser")
  analyticsEvents    AnalyticsEvent[]
  shareTokens        ShareToken[]
  leads              Lead[]
  qrImpulses         QrImpulse[]
  encartes           Encarte[]
  qrSlots            QrSlot[]
  qrTemplates        QrTemplate[]
  campaigns          Campaign[]
  sweepstakes        Sweepstake[]
  loyaltyPoints      LoyaltyPoint[]

  @@index([locationId])
  @@index([segmentId])
  @@map("Usuario_Loja")
}

model Campaign {
  id              Int           @id @default(autoincrement())
  subject         String
  content         String
  sentAt          DateTime      @default(now())
  establishmentId Int
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  @@index([establishmentId])
  @@map("Campanhas")
}

model Offer {
  id                 Int              @id @default(autoincrement()) @map("Id")
  title              String           @map("Titulo")
  slug               String?
  description        String?          @map("Descricao")
  price              String?          @map("Valor")
  originalPrice      String?
  discountPercentage Float?
  image              String?          @map("Imagem")
  active             Boolean          @default(true) @map("Ativo")
  highlight          Boolean          @default(false)
  startDate          DateTime?        @map("DataInicio")
  endDate            DateTime?        @map("DataFim")
  establishmentId    Int
  createdAt          DateTime         @default(now()) @map("DataCadastro")
  updatedAt          DateTime         @updatedAt @map("DataAtualizacao")
  publicationId      Int?
  establishment      Establishment    @relation(fields: [establishmentId], references: [id])
  publication        Publication?     @relation("PublicationOffers", fields: [publicationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  analyticsEvents    AnalyticsEvent[]

  @@index([establishmentId])
  @@index([establishmentId, active])
  @@map("Produto_Oferta")
}

model Publication {
  id                Int                @id @default(autoincrement()) @map("Id")
  title             String             @map("Titulo")
  description       String?            @map("Descricao")
  status            String             @default("DRAFT") @map("Status")
  startDate         DateTime?          @map("DataInicio")
  endDate           DateTime?          @map("DataFim")
  priority          String             @default("Média") @map("Prioridade")
  establishmentId   Int
  createdAt         DateTime           @default(now()) @map("DataCadastro")
  updatedAt         DateTime           @updatedAt @map("DataAtualizacao")
  offers            Offer[]            @relation("PublicationOffers")
  establishment     Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leadNotifications LeadNotification[]

  @@index([establishmentId, status])
  @@map("Promocao")
}

model Follow {
  id              Int           @id @default(autoincrement())
  userId          Int
  establishmentId Int
  createdAt       DateTime      @default(now())
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, establishmentId])
  @@index([establishmentId])
  @@map("Favorito")
}

model ShareToken {
  id              Int           @id @default(autoincrement())
  token           String        @unique
  establishmentId Int
  clickCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  leads           Lead[]

  @@index([establishmentId])
  @@map("TokenCompartilhamento")
}

model Lead {
  id              Int                @id @default(autoincrement())
  phone           String
  establishmentId Int
  shareTokenId    Int?
  consentAt       DateTime           @default(now())
  consentText     String
  active          Boolean            @default(true)
  unsubscribedAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  establishment   Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  shareToken      ShareToken?        @relation(fields: [shareTokenId], references: [id], onDelete: SetNull)
  notifications   LeadNotification[]

  @@unique([phone, establishmentId])
  @@index([establishmentId, active])
  @@map("Lead")
}

model LeadNotification {
  id            Int         @id @default(autoincrement())
  leadId        Int
  publicationId Int
  status        String      @default("PENDING") // PENDING | SENT | FAILED
  sentAt        DateTime    @default(now())
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([leadId, publicationId])
  @@map("NotificacaoLead")
}

enum QrTargetType {
  STORE
  PROMOTIONS
  PUBLICATIONS
  CITY
  SEGMENT
  USER_STORES
}

enum QrTemplateMode {
  STORE
  CITY_SEGMENT
  STORES
}

model QrTemplate {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  totalSlots  Int
  mode        QrTemplateMode @default(STORE)
  active      Boolean        @default(true)

  // Novos campos para pré-vinculação
  locationId      Int?
  establishmentId Int?
  segmentIds      Int[] @default([])

  location      Location?      @relation(fields: [locationId], references: [id])
  establishment Establishment? @relation(fields: [establishmentId], references: [id])

  slots     QrSlot[]
  impulses  QrImpulse[]
  encartes  Encarte[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model QrSlot {
  id              Int            @id @default(autoincrement())
  templateId      Int
  template        QrTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  position        Int
  label           String
  targetType      QrTargetType
  segmentId       Int?
  segment         Segment?       @relation(fields: [segmentId], references: [id])
  establishmentId Int?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([templateId, position])
}

model QrImpulse {
  id              Int            @id @default(autoincrement())
  templateId      Int
  establishmentId Int?
  locationId      Int?
  segmentIds      Int[]
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  location        Location?      @relation(fields: [locationId], references: [id])
  template        QrTemplate     @relation(fields: [templateId], references: [id])
  generatedAt     DateTime?
  images          Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AnalyticsEvent {
  id              Int           @id @default(autoincrement())
  eventType       String
  establishmentId Int
  offerId         Int?
  sessionId       String?
  createdAt       DateTime      @default(now())
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  offer           Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([establishmentId, eventType, createdAt])
  @@map("EventosAnalytics")
}

model Encarte {
  id              Int            @id @default(autoincrement())
  titulo          String
  descricao       String?
  dataValidade    DateTime?
  imagemCapaUrl   String?
  locationId      Int?
  location        Location?      @relation(fields: [locationId], references: [id])
  templateId      Int?
  template        QrTemplate?    @relation(fields: [templateId], references: [id])
  establishmentId Int?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])
  qrCodes         Json? // Stores generated base64 images or metadata
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([locationId])
  @@index([establishmentId])
  @@map("EncartesModule")
}

model Sweepstake {
  id              Int                @id @default(autoincrement())
  establishmentId Int
  title           String
  description     String?
  type            String             @default("DEFAULT")
  startDate       DateTime?
  endDate         DateTime?
  prizeQuantity   Int                @default(1)
  prizeDesc       String?
  discountDesc    String?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  establishment   Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  tickets         SweepstakeTicket[]

  @@index([establishmentId])
  @@map("Sweepstake")
}

model SweepstakeTicket {
  id           Int        @id @default(autoincrement())
  userId       Int
  sweepstakeId Int
  hashcode     String     @unique
  winner       Boolean    @default(false)
  drawDate     DateTime?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sweepstake   Sweepstake @relation(fields: [sweepstakeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sweepstakeId])
  @@map("SweepstakeTicket")
}

model LoyaltyPoint {
  id              Int           @id @default(autoincrement())
  userId          Int
  establishmentId Int
  points          Int
  value           Decimal?
  reason          String?
  sourceType      String        @default("MANUAL")
  status          String        @default("ACTIVE") // ACTIVE, USED, EXPIRED
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([establishmentId])
  @@map("LoyaltyPoint")
}
